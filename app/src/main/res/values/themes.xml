<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the window the activity opens into. Everything the user sees is
      drawn by Compose, so this holds nothing but a background colour that
      matches the light theme's surface and keeps the launch from flashing
      white or black.
    -->
    <style name="Theme.Zaka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      The window the app launches into, handed over to Theme.Zaka as soon as
      the first frame is ready. The icon is the launcher icon's foreground, so
      the thing that was tapped is the thing that grows into the app.
    -->
    <style name="Theme.Zaka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Zaka</item>
    </style>
</resources>
